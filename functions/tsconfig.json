{
  "compilerOptions": {
    "module": "NodeNext",
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "resolveJsonModule": true,
    "target": "es6",
    "skipLibCheck": true,
    "lib": ["es2020"],
    "types": ["node", "jest"]
  },
  "compileOnSave": true,
  "include": ["src/**/*", "__tests__/**/*", "../scripts/seed.ts"],
  "exclude": ["node_modules", "lib", "coverage"]
}
