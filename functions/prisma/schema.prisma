// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  price       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Certifications {
  cert_id         Int      @id @default(autoincrement())
  name            String
  exam_guide_url  String?
  min_quiz_counts Int
  max_quiz_counts Int
  cert_category_id Int
  pass_score      Float

  certCategory    CertCategories @relation(fields: [cert_category_id], references: [cert_category_id])
  quizQuestions   QuizQuestions[]
  exams           Exams[]
}

model CertCategories {
  cert_category_id Int      @id @default(autoincrement())
  name             String

  certifications   Certifications[]
}

model Users {
  user_id Int      @id @default(autoincrement())

  exams   Exams[]
}


model QuizQuestions {
  quiz_question_id Int      @id @default(autoincrement())
  cert_id          Int
  difficulty       String
  topic            String
  question_body    String
  answer_options   String
  correct_answers  String
  explanations     String?

  certification    Certifications @relation(fields: [cert_id], references: [cert_id])
}

model Exams {
  exam_id             Int      @id @default(autoincrement())
  user_id             Int
  cert_id             Int
  quiz_question_id_list String
  score               Float
  started_at          DateTime
  submitted_at        DateTime?

  user                Users @relation(fields: [user_id], references: [user_id])
  certification       Certifications @relation(fields: [cert_id], references: [cert_id])
}
