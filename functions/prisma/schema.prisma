// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CertificationStatus {
  PASSED
  IN_PROGRESS
  INTERESTED
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Certifications {
  cert_id          String @id @default(uuid())
  cert_category_id String // Foreign Key

  name            String
  exam_guide_url  String?
  min_quiz_counts Int
  max_quiz_counts Int
  pass_score      Float

  certCategory       CertCategories      @relation(fields: [cert_category_id], references: [cert_category_id])
  quizQuestions      QuizQuestions[] // Relation to its question bank
  exams              Exams[]
  userCertifications UserCertification[] // Relation to the join table
}

model CertCategories {
  cert_category_id String @id @default(uuid())
  name             String

  certifications Certifications[]
}

model Users {
  user_id          String  @id @default(uuid())
  firebase_user_id String? @unique

  exams              Exams[]
  userCertifications UserCertification[] // Relation to the join table
}

// New join table for Many-to-Many relationship between Users and Certifications with status
model UserCertification {
  user_id String // Foreign Key
  cert_id String // Foreign Key

  status     CertificationStatus
  assignedAt DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  user          Users          @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  certification Certifications @relation(fields: [cert_id], references: [cert_id], onDelete: Cascade)

  // @@index([status])
  // @@index([cert_id, status])

  @@id([user_id, cert_id])
}

model QuizQuestions {
  quiz_question_id String @id @default(uuid())
  cert_id          String // Foreign Key // Links the question to a specific Certification

  difficulty    String // Consider Enum
  topic         String // Consider Enum
  question_body String
  // answer_options   String
  // correct_answers  String
  answerOptions AnswerOption[] // Relation to its answer options
  explanations  String?

  createdAt DateTime @default(now()) // Added timestamp
  updatedAt DateTime @updatedAt // Added timestamp

  certification Certifications    @relation(fields: [cert_id], references: [cert_id], onDelete: Cascade)
  examEntries   ExamUserAnswers[] // Relation to the join table for exams

  // @@index([topic])
  // @@index([difficulty])
}

model AnswerOption {
  option_id        String  @id @default(uuid())
  quiz_question_id String // Foreign Key
  option_text      String
  is_correct       Boolean // True if this option is a correct answer

  createdAt DateTime @default(now()) // Added timestamp
  updatedAt DateTime @updatedAt // Added timestamp

  quizQuestion    QuizQuestions     @relation(fields: [quiz_question_id], references: [quiz_question_id], onDelete: Cascade)
  selectedInExams ExamUserAnswers[]
}

model Exams {
  exam_id String @id @default(uuid())
  user_id String // Foreign Key
  cert_id String // Foreign Key

  score        Float? // Score can be null until exam is graded
  started_at   DateTime  @default(now())
  submitted_at DateTime?

  user          Users             @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  certification Certifications    @relation(fields: [cert_id], references: [cert_id], onDelete: Cascade)
  answers       ExamUserAnswers[] // Relation to the join table linking to QuizQuestions
}

// This model links Exams to QuizQuestions and stores the user's answer for each question in an exam
model ExamUserAnswers {
  exam_question_id String @id @default(uuid())
  exam_id          String // Foreign Key
  quiz_question_id String // Foreign Key

  // user_answer       String?
  selected_option_id String?
  is_correct         Boolean?

  exam           Exams         @relation(fields: [exam_id], references: [exam_id], onDelete: Cascade)
  quizQuestion   QuizQuestions @relation(fields: [quiz_question_id], references: [quiz_question_id], onDelete: Cascade)
  selectedOption AnswerOption? @relation(fields: [selected_option_id], references: [option_id], onDelete: SetNull)

  @@unique([exam_id, quiz_question_id]) // Ensures a question appears only once per exam
}
