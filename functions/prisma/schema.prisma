// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CertificationStatus {
  PASSED
  IN_PROGRESS
  INTERESTED
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Certifications {
  cert_id          Int @id @default(autoincrement())
  cert_category_id Int // Foreign Key

  name            String
  exam_guide_url  String?
  min_quiz_counts Int
  max_quiz_counts Int
  pass_score      Float

  cert_category      CertCategories      @relation(fields: [cert_category_id], references: [cert_category_id])
  certTopics         CertTopic[]
  quizQuestions      QuizQuestions[]
  exams              Exams[]
  userCertifications UserCertification[]
}

model CertCategories {
  cert_category_id Int    @id @default(autoincrement())
  name             String

  certifications Certifications[]
}

model Topic {
  id            Int             @id @default(autoincrement())
  name          String          @unique
  certTopics    CertTopic[]
  quizQuestions QuizQuestions[]
}

model CertTopic {
  cert_id  Int
  topic_id Int

  certification Certifications @relation(fields: [cert_id], references: [cert_id], onDelete: Cascade)
  topic         Topic          @relation(fields: [topic_id], references: [id], onDelete: Cascade)

  @@id([cert_id, topic_id])
}

model Users {
  user_id          String  @id @default(uuid())
  firebase_user_id String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  exams              Exams[]
  userCertifications UserCertification[] // Relation to the join table
}

model UserCertification {
  user_id String // Foreign Key
  cert_id Int // Foreign Key

  status     CertificationStatus
  assignedAt DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  user          Users          @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  certification Certifications @relation(fields: [cert_id], references: [cert_id], onDelete: Cascade)

  // @@index([status])
  // @@index([cert_id, status])

  @@id([user_id, cert_id])
}

model QuizQuestions {
  quiz_question_id String @id @default(uuid())
  cert_id          Int
  topic_id         Int?

  difficulty    String?
  question_body String
  answerOptions AnswerOption[]
  explanations  String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isDeprecated Boolean  @default(false)

  certification Certifications    @relation(fields: [cert_id], references: [cert_id], onDelete: Cascade)
  topic         Topic?            @relation(fields: [topic_id], references: [id], onDelete: Cascade)
  examEntries   ExamUserAnswers[]

  @@index([cert_id])
  @@index([topic_id])
}

model AnswerOption {
  option_id        String  @id @default(uuid())
  quiz_question_id String // Foreign Key
  option_text      String
  is_correct       Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quizQuestion    QuizQuestions     @relation(fields: [quiz_question_id], references: [quiz_question_id], onDelete: Cascade)
  selectedInExams ExamUserAnswers[]
}

enum ExamStatus {
  PENDING_QUESTIONS
  QUESTIONS_GENERATING
  READY
  IN_PROGRESS
  COMPLETED
  QUESTION_GENERATION_FAILED
}

model Exams {
  exam_id String @id @default(uuid())
  user_id String
  cert_id Int // Foreign Key

  exam_status     ExamStatus @default(PENDING_QUESTIONS)
  total_questions Int?
  score           Float?
  started_at      DateTime   @default(now())
  submitted_at    DateTime?

  user          Users             @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  certification Certifications    @relation(fields: [cert_id], references: [cert_id], onDelete: Cascade)
  answers       ExamUserAnswers[]
}

model ExamUserAnswers {
  user_answer_id   String @id @default(uuid())
  exam_id          String // Foreign Key
  quiz_question_id String // Foreign Key

  selected_option_id String?
  is_correct         Boolean?

  exam           Exams         @relation(fields: [exam_id], references: [exam_id], onDelete: Cascade)
  quizQuestion   QuizQuestions @relation(fields: [quiz_question_id], references: [quiz_question_id], onDelete: Cascade)
  selectedOption AnswerOption? @relation(fields: [selected_option_id], references: [option_id], onDelete: SetNull)

  @@unique([exam_id, quiz_question_id])
}
