// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CertificationStatus {
  PASSED
  IN_PROGRESS
  INTERESTED
}

enum DifficultyLevel {
  EASY
  ADVANCED
  EXPERT
}

model Firm {
  firm_id     Int     @id @default(autoincrement())
  name        String  @unique
  code        String  @unique // Short code like "AWS", "GCP", "IBM"
  description String?
  website_url String?
  logo_url    String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  certifications Certification[]

  @@index([code])
}

model Certification {
  cert_id Int @id @default(autoincrement())
  firm_id Int // Foreign Key
  // cert_category_id Int // Foreign Key

  name            String
  exam_guide_url  String?
  min_quiz_counts Int
  max_quiz_counts Int
  pass_score      Float

  firm               Firm                @relation(fields: [firm_id], references: [firm_id], onDelete: Cascade)
  quizQuestions      QuizQuestion[]
  examAttempts       ExamAttempt[]
  userCertifications UserCertification[]

  @@index([firm_id])
}

model User {
  user_id          String  @id @default(uuid())
  firebase_user_id String? @unique
  credit_tokens    Int     @default(300)
  energy_tokens    Int     @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  examAttempts       ExamAttempt[]
  userCertifications UserCertification[] // Relation to the join table
}

model UserCertification {
  user_id String // Foreign Key
  cert_id Int // Foreign Key

  status      CertificationStatus
  assigned_at DateTime            @default(now())
  updated_at  DateTime            @updatedAt

  user          User          @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  certification Certification @relation(fields: [cert_id], references: [cert_id], onDelete: Cascade)

  @@id([user_id, cert_id])
}

model QuizQuestion {
  quiz_question_id String  @id @default(uuid())
  cert_id          Int
  generated_from   String? // References ExamAttempt.exam_id

  difficulty    DifficultyLevel @default(EASY)
  question_text String
  explanations  String?
  exam_topic    String?

  created_at    DateTime @default(now())
  is_deprecated Boolean  @default(false)

  answerOptions     AnswerOption[]
  certification     Certification    @relation(fields: [cert_id], references: [cert_id], onDelete: Cascade)
  examEntries       ExamUserAnswer[]
  generatedFromExam ExamAttempt?     @relation("GeneratedQuestions", fields: [generated_from], references: [exam_id], onDelete: SetNull)

  @@index([cert_id])
  @@index([generated_from])
}

model AnswerOption {
  option_id        String  @id @default(uuid())
  quiz_question_id String // Foreign Key
  option_text      String
  is_correct       Boolean

  created_at DateTime @default(now())

  quizQuestion    QuizQuestion     @relation(fields: [quiz_question_id], references: [quiz_question_id], onDelete: Cascade)
  selectedInExams ExamUserAnswer[]
}

enum ExamStatus {
  PENDING_QUESTIONS
  QUESTIONS_GENERATING
  READY
  IN_PROGRESS
  COMPLETED
  QUESTION_GENERATION_FAILED
}

model ExamAttempt {
  exam_id String @id @default(uuid())
  user_id String
  cert_id Int // Foreign Key

  exam_status        ExamStatus @default(PENDING_QUESTIONS)
  total_questions    Int?
  score              Float?
  token_cost         Int        @default(60)
  custom_prompt_text String? // Store the custom prompt used for question generation
  started_at         DateTime   @default(now())
  submitted_at       DateTime?

  user               User             @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  certification      Certification    @relation(fields: [cert_id], references: [cert_id], onDelete: Cascade)
  answers            ExamUserAnswer[]
  generatedQuestions QuizQuestion[]   @relation("GeneratedQuestions")
}

model ExamUserAnswer {
  user_answer_id   String @id @default(uuid())
  exam_id          String // Foreign Key
  quiz_question_id String // Foreign Key

  selected_option_id String?
  is_correct         Boolean?

  examAttempt    ExamAttempt   @relation(fields: [exam_id], references: [exam_id], onDelete: Cascade)
  quizQuestion   QuizQuestion  @relation(fields: [quiz_question_id], references: [quiz_question_id], onDelete: Cascade)
  selectedOption AnswerOption? @relation(fields: [selected_option_id], references: [option_id], onDelete: SetNull)

  @@unique([exam_id, quiz_question_id])
}
