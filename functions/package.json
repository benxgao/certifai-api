{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "functions",
  "version": "1.0.0",
  "description": "Firebase Functions for Co-Workout",
  "author": "Ben Gao",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "rm -rf lib && tsc",
    "build:watch": "tsc --watch",
    "serve": "firebase use certifai-prod && npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "dev": "npm run serve",
    "deploy": "GOOGLE_APPLICATION_CREDENTIALS=./gcp_credentials.json firebase deploy --only functions --non-interactive --debug",
    "logs": "firebase functions:log",
    "test": "echo \"No test specified\" && exit 0"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@genkit-ai/google-cloud": "^1.10.0",
    "@genkit-ai/googleai": "^1.10.0",
    "@genkit-ai/vertexai": "^1.10.0",
    "@google-cloud/pubsub": "^5.0.0",
    "@google-cloud/secret-manager": "^6.0.1",
    "@google-cloud/tasks": "^6.1.0",
    "@prisma/extension-accelerate": "^2.0.1",
    "@upstash/redis": "^1.35.0",
    "compression": "^1.8.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.0.1",
    "genkit": "^1.10.0",
    "helmet": "^8.1.0",
    "jose": "^6.0.11",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^3.3.2",
    "ramda": "^0.30.1"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.9",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.26.0",
    "@prisma/client": "^6.8.2",
    "@types/compression": "^1.8.0",
    "@types/express": "^5.0.2",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "eslint": "^9.26.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.1.0",
    "firebase-tools": "^14.4.0",
    "globals": "^16.2.0",
    "prisma": "^6.8.2",
    "typescript": "^5.8.2"
  },
  "private": true
}
